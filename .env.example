# ─────────────────────────────────────────────────────────────
# Promo.ai 환경 변수 (SPEC 0.4)
# 이 파일을 복사해 `.env.local`을 만들고 실제 값을 채워주세요.
#   cp .env.example .env.local
# .env.local 은 절대 커밋하지 않습니다(.gitignore 처리됨).
# ─────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL (클라이언트 노출)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 익명 키 (클라이언트 노출)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase 서비스 롤 키 (서버 전용 · 우회 권한 · 절대 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API 키 (서버 전용 · LLM 호출)
ANTHROPIC_API_KEY=

# (선택) AI 카피 생성에 사용할 모델 ID. 미설정 시 lib/ai 기본값 사용.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# 인증 pepper (서버 전용 · 4자리 PIN 파생 비밀번호/재설정 토큰 서명용)
# 아무나 추측할 수 없는 긴 랜덤 문자열로 설정하세요. 예: `openssl rand -base64 48`
# ⚠️ 이 값을 바꾸면 기존 사용자의 로그인이 불가능해집니다(파생 비밀번호가 달라짐).
AUTH_PIN_PEPPER=
