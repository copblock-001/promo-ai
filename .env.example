# ─────────────────────────────────────────────────────────────
# Promo.ai 환경 변수 (SPEC 0.4)
# 이 파일을 복사해 `.env.local`을 만들고 실제 값을 채워주세요.
#   cp .env.example .env.local
# .env.local 은 절대 커밋하지 않습니다(.gitignore 처리됨).
# ─────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL (클라이언트 노출)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 익명 키 (클라이언트 노출)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase 서비스 롤 키 (서버 전용 · 우회 권한 · 절대 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API 키 (서버 전용 · LLM 호출)
ANTHROPIC_API_KEY=

# (선택) AI 카피 생성에 사용할 모델 ID. 미설정 시 lib/ai 기본값 사용.
# ANTHROPIC_MODEL=claude-sonnet-4-6
